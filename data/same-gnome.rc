            VALUE "ProductName", "Same GNOME"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END

1 RT_MANIFEST "same-gnome.manifest"